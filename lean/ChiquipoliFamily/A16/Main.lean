theorem L_pos {z : ℝ} (h0 : 0 < z) (hpi : z < Real.pi) : 0 < L z := by
  unfold L
  have := Real.sin_pos_of_pos_of_lt_pi (x := z / 2) (by linarith) (by linarith [Real.pi_pos])
