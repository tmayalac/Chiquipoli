      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (4 : Fin 16); rw [succ_4] at this; exact this))) (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hd (9 : Fin 15); rw [ea_9, eb_9] at this; exact this))) z5 z13
