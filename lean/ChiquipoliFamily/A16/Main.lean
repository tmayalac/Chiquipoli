      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (13 : Fin 16); rw [succ_13] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (11 : Fin 15); rw [ea_11, eb_11] at this; exact this)) z14 z6
    rw [P_13, P_14, P_6, det_reduced]
