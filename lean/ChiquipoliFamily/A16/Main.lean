  have z3 : w' (3 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (10 : Fin 16)) (Pj := P z (2 : Fin 16)) (wi := w' (10 : Fin 16)) (wj := w' (2 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hd (6 : Fin 15); rw [ea_6, eb_6] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hs (2 : Fin 16); rw [succ_2] at this; exact this)) z10 z2
    rw [P_3, P_10, P_2, det_reduced]
