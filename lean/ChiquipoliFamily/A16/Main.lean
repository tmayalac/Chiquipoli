      (bar_sub_rigid (t := t) (ω := ω) (by have := hd (8 : Fin 15); rw [ea_8, eb_8] at this; exact this)) (bar_sub_rigid (t := t) (ω := ω) (by have := hs (11 : Fin 16); rw [succ_11] at this; exact this)) z3 z11
    rw [P_12, P_3, P_11, det_reduced]
    exact (mul_pos hsz (henD_12 _ h₁ h₂)).ne'
  have z5 : w' (5 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (6 : Fin 16)) (Pj := P z (13 : Fin 16)) (wi := w' (6 : Fin 16)) (wj := w' (13 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (5 : Fin 16); rw [succ_5] at this; exact this))) (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hd (10 : Fin 15); rw [ea_10, eb_10] at this; exact this))) z6 z13
    rw [P_5, P_6, P_13, det_reduced]
