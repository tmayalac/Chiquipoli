  have z11 : w' (11 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (3 : Fin 16)) (Pj := P z (10 : Fin 16)) (wi := w' (3 : Fin 16)) (wj := w' (10 : Fin 16))
      (bar_sub_rigid (t := t) (ω := ω) (by have := hd (7 : Fin 15); rw [ea_7, eb_7] at this; exact this)) (bar_sub_rigid (t := t) (ω := ω) (by have := hs (10 : Fin 16); rw [succ_10] at this; exact this)) z3 z10
