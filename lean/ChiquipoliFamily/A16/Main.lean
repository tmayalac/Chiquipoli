/-- **`I_eq ⊆ R_eq`, by a Henneberg construction.** Pin the first side by a rigid
motion; then every other vertex is pinned in turn by two bars with independent
directions (`henD_*`). The displacement minus the rigid motion vanishes. -/
theorem Ieq_imp_R (z : ℝ) (hsz : 0 < Real.sin z) (h₁ : clo ≤ Real.cos z) (h₂ : Real.cos z ≤ chi)
    (hl : L z ≠ 0) (w : Cfg 16) (h : (dataOf (P z) (L z) ea eb).Ieq w 0) :
    (dataOf (P z) (L z) ea eb).R w := by
  obtain ⟨hs, hd⟩ := bars_of_Ieq hl h
  have hne : P z (0 : Fin 16) ≠ P z (1 : Fin 16) := by
    intro heq
    have := convexOrdered z hsz h₁ h₂ (0 : Fin 16) (2 : Fin 16) (by decide) (by decide)
    rw [succ_0, heq] at this
    simp [cross_eq] at this
  have hb01 := hs (0 : Fin 16)
  rw [succ_0] at hb01
  obtain ⟨t, ω, h0, h1⟩ := pin_bar hne hb01
  set w' : Cfg 16 := fun k => w k - (t + ω • J (P z k)) with hw'
  have z0 : w' (0 : Fin 16) = 0 := by simp only [hw', h0, sub_self]
  have z1 : w' (1 : Fin 16) = 0 := by simp only [hw', h1, sub_self]
  have z9 : w' (9 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (0 : Fin 16)) (Pj := P z (1 : Fin 16)) (wi := w' (0 : Fin 16)) (wj := w' (1 : Fin 16))
      (bar_sub_rigid (t := t) (ω := ω) (by have := hd (2 : Fin 15); rw [ea_2, eb_2] at this; exact this)) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (3 : Fin 15); rw [ea_3, eb_3] at this; exact this)) z0 z1
    rw [P_9, P_0, P_1, det_reduced]
    exact (mul_pos hsz (henD_9 _ h₁ h₂)).ne'
  have z8 : w' (8 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (9 : Fin 16)) (Pj := P z (0 : Fin 16)) (wi := w' (9 : Fin 16)) (wj := w' (0 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (8 : Fin 16); rw [succ_8] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (1 : Fin 15); rw [ea_1, eb_1] at this; exact this)) z9 z0
    rw [P_8, P_9, P_0, det_reduced]
    exact (mul_pos hsz (henD_8 _ h₁ h₂)).ne'
  have z7 : w' (7 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (8 : Fin 16)) (Pj := P z (0 : Fin 16)) (wi := w' (8 : Fin 16)) (wj := w' (0 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (7 : Fin 16); rw [succ_7] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (0 : Fin 15); rw [ea_0, eb_0] at this; exact this)) z8 z0
    rw [P_7, P_8, P_0, det_reduced]
    exact (mul_pos hsz (henD_7 _ h₁ h₂)).ne'
  have z15 : w' (15 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (0 : Fin 16)) (Pj := P z (7 : Fin 16)) (wi := w' (0 : Fin 16)) (wj := w' (7 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (15 : Fin 16); rw [succ_15] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (14 : Fin 15); rw [ea_14, eb_14] at this; exact this)) z0 z7
    rw [P_15, P_0, P_7, det_reduced]
    exact (mul_pos hsz (henD_15 _ h₁ h₂)).ne'
  have z14 : w' (14 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (15 : Fin 16)) (Pj := P z (7 : Fin 16)) (wi := w' (15 : Fin 16)) (wj := w' (7 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (14 : Fin 16); rw [succ_14] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (13 : Fin 15); rw [ea_13, eb_13] at this; exact this)) z15 z7
    rw [P_14, P_15, P_7, det_reduced]
    exact (mul_pos hsz (henD_14 _ h₁ h₂)).ne'
  have z2 : w' (2 : Fin 16) = 0 := by
    apply henneberg_step (Pi := P z (9 : Fin 16)) (Pj := P z (1 : Fin 16)) (wi := w' (9 : Fin 16)) (wj := w' (1 : Fin 16))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hd (4 : Fin 15); rw [ea_4, eb_4] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hs (1 : Fin 16); rw [succ_1] at this; exact this)) z9 z1
