/-- `4 sin²(z/2) = 2 − 2 cos z`. -/
lemma four_sin_sq_half (z : ℝ) : 4 * sin (z / 2) ^ 2 = 2 - 2 * cos z := by
  have h2 : (2 : ℝ) * (z / 2) = z := by ring
  have hc := Cheb.cos_2 (z / 2)
  rw [h2] at hc
  linear_combination 4 * Cheb.pyth (z / 2) + 2 * hc

/-- Upstream's constructor equation is `4096 · Fc (cos z)` wherever `cos 2z ≠ 0`. -/
theorem F_eq (z : ℝ) (hD : cos (2 * z) ≠ 0) : Optigon.F 16 z = 4096 * Fc (cos z) := by
  have e1 : ((((16 : ℕ) : ℝ)) / 4 - 2) * z = 2 * z := by push_cast; ring
  have e2 : ((16 : ℕ) : ℝ) * z / 4 = 4 * z := by push_cast; ring
  have e3 : ((((16 : ℕ) : ℝ)) / 2 - 1) * z = 7 * z := by push_cast; ring
  simp only [Optigon.F, Optigon.x]
  rw [e1, e2, e3, four_sin_sq_half]
  rw [Cheb.cos_2] at hD
  simp only [Cheb.sin_2, Cheb.cos_2, Cheb.sin_3, Cheb.cos_3, Cheb.sin_4, Cheb.cos_4, Cheb.sin_5, Cheb.cos_5, Cheb.sin_6, Cheb.cos_6, Cheb.sin_7, Cheb.cos_7, Cheb.sin_8, Cheb.cos_8]
  unfold Fc
  generalize hDv : 2 * cos z ^ 2 - 1 = D at hD ⊢
  first | ring1 | (field_simp <;> (try rw [← hDv]) <;> first | ring1 | (simp; done) | (ring_nf <;> simp only [sin_sq] <;> ring_nf))

/-- The published polygon, as a labelled configuration: vertex `k` is upstream's `(a[k], b[k])`. -/
noncomputable def Q (z : ℝ) : Fin 16 → ℝ × ℝ := fun k => Optigon.vertex 16 z k

theorem Q_eq_P (z : ℝ) (hD : cos (2 * z) ≠ 0) : Q z = P z := by
  funext k
  fin_cases k
  · show Optigon.vertex 16 z 0 = P z (0 : Fin 16)
    rw [P_0]; exact pub_0 z hD
  · show Optigon.vertex 16 z 1 = P z (1 : Fin 16)
    rw [P_1]; exact pub_1 z hD
  · show Optigon.vertex 16 z 2 = P z (2 : Fin 16)
    rw [P_2]; exact pub_2 z hD
  · show Optigon.vertex 16 z 3 = P z (3 : Fin 16)
    rw [P_3]; exact pub_3 z hD
  · show Optigon.vertex 16 z 4 = P z (4 : Fin 16)
    rw [P_4]; exact pub_4 z hD
  · show Optigon.vertex 16 z 5 = P z (5 : Fin 16)
    rw [P_5]; exact pub_5 z hD
  · show Optigon.vertex 16 z 6 = P z (6 : Fin 16)
    rw [P_6]; exact pub_6 z hD
  · show Optigon.vertex 16 z 7 = P z (7 : Fin 16)
    rw [P_7]; exact pub_7 z hD
  · show Optigon.vertex 16 z 8 = P z (8 : Fin 16)
    rw [P_8]; exact pub_8 z hD
  · show Optigon.vertex 16 z 9 = P z (9 : Fin 16)
    rw [P_9]; exact pub_9 z hD
  · show Optigon.vertex 16 z 10 = P z (10 : Fin 16)
    rw [P_10]; exact pub_10 z hD
  · show Optigon.vertex 16 z 11 = P z (11 : Fin 16)
    rw [P_11]; exact pub_11 z hD
  · show Optigon.vertex 16 z 12 = P z (12 : Fin 16)
    rw [P_12]; exact pub_12 z hD
  · show Optigon.vertex 16 z 13 = P z (13 : Fin 16)
    rw [P_13]; exact pub_13 z hD
