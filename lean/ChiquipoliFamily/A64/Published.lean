lemma hi_eq : Optigon.hi 64 = searchHi := by unfold Optigon.hi searchHi; norm_num

lemma cos2_ne {z : ℝ} (hz : z ∈ Ioo searchLo searchHi) : cos (2 * z) ≠ 0 :=
  (Optigon.cos_two_pos (n := 64) (by norm_num) (lt_trans searchLo_pos hz.1) (by rw [hi_eq]; exact hz.2)).ne'

/-- **A64, stated about the published objects.** Upstream's constructor equation
`Optigon.F 64` has exactly one zero `z` in upstream's bracket `(lo, hi)`, and the
polygon upstream builds there, `Q z`, with side `2 sin(z/2)`, is a strictly
convex equilateral small 64`-gon and a strict local maximiser of the perimeter,
modulo orientation-preserving Euclidean motions. -/
theorem published_locally_maximal :
    ∃ z : ℝ, z ∈ Ioo (Optigon.lo 64) (Optigon.hi 64) ∧ Optigon.F 64 z = 0 ∧
      (∀ z' ∈ Ioo (Optigon.lo 64) (Optigon.hi 64), Optigon.F 64 z' = 0 → z' = z) ∧
      0 < 2 * sin (z / 2) ∧ IsFeasibleConvex (Q z, 2 * sin (z / 2)) ∧
      (∀ᶠ y in nhds ((Q z, 2 * sin (z / 2)) : Amb 64), IsFeasible y → 2 * sin (z / 2) ≤ y.2 →
          Chiquipoli.Feasible.Congruent y.1 (Q z) ∧ y.2 = 2 * sin (z / 2)) ∧
      (∀ᶠ y in nhds ((Q z, 2 * sin (z / 2)) : Amb 64), IsFeasible y → y.2 ≤ 2 * sin (z / 2)) := by
  obtain ⟨c, hc, hFc⟩ := Fc_root
  obtain ⟨hl, hfeas, hev, hle⟩ := locally_maximal_at hc hFc
  obtain ⟨bH, bL⟩ := bracket_in_search
  have hcm1 : (-1 : ℝ) ≤ c := by have := hc.1; have := clo_pos; linarith
  have hc1 : c ≤ 1 := by have := hc.2; have := chi_lt_one; linarith
  have hcos : Real.cos (Real.arccos c) = c := Real.cos_arccos hcm1 hc1
  have hHi0 : 0 ≤ searchHi := by unfold searchHi; positivity
  have hmem : Real.arccos c ∈ Ioo searchLo searchHi := by
    constructor
    · have h := Real.arccos_lt_arccos hcm1 (by linarith [hc.2]) (Real.cos_le_one searchLo)
      rwa [Real.arccos_cos searchLo_pos.le searchLo_le_pi] at h
    · have h := Real.arccos_lt_arccos (Real.neg_one_le_cos searchHi) (by linarith [hc.1]) hc1
      rwa [Real.arccos_cos hHi0 searchHi_le_pi] at h
  have hQ := Q_eq_P (Real.arccos c) (cos2_ne hmem)
  have hL : L (Real.arccos c) = 2 * sin (Real.arccos c / 2) := rfl
  rw [lo_eq, hi_eq]
  refine ⟨Real.arccos c, hmem, by rw [F_eq _ (cos2_ne hmem), hcos, hFc]; ring, ?_, by rw [← hL]; exact hl,
    by rw [hQ, ← hL]; exact hfeas, by rw [hQ, ← hL]; exact hev, by rw [hQ, ← hL]; exact hle⟩
  intro z' hz' hF'
  rw [F_eq _ (cos2_ne hz')] at hF'
  have hF0 : Fc (Real.cos z') = 0 := by
    rcases mul_eq_zero.mp hF' with h | h
    · norm_num at h
    · exact h
  have hc' := cos_mem_of_search hz'
  have hcz := cos_mem_of_search hmem
  have heq : Real.cos z' = Real.cos (Real.arccos c) :=
    Fc_root_unique_search hc' hcz hF0 (by rw [hcos]; exact hFc)
  have hsub : ∀ w ∈ Ioo searchLo searchHi, w ∈ Icc 0 π := fun w hw =>
    ⟨by linarith [hw.1, searchLo_pos], by linarith [hw.2, searchHi_le_pi]⟩
  exact Real.injOn_cos (hsub z' hz') (hsub _ hmem) heq

end Chiquipoli.Family.A64
