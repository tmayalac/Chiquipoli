theorem Fc_mono_search : StrictMonoOn Fc (Icc slo shi) := by
  refine strictMonoOn_of_deriv_pos (convex_Icc _ _) Fc_continuous.continuousOn ?_
  intro x hx
  rw [interior_Icc] at hx
  rw [(hasDerivAt_Fc x).deriv]
  have := dFc_lb x hx.1.le hx.2.le
  linarith

/-- `Fc` has at most one root on `[slo, shi]`. -/
theorem Fc_root_unique_search {x y : ℝ} (hx : x ∈ Icc slo shi) (hy : y ∈ Icc slo shi)
    (hfx : Fc x = 0) (hfy : Fc y = 0) : x = y := by
  rcases lt_trichotomy x y with h | h | h
  · have := Fc_mono_search hx hy h; rw [hfx, hfy] at this; exact absurd this (lt_irrefl 0)
  · exact h
  · have := Fc_mono_search hy hx h; rw [hfx, hfy] at this; exact absurd this (lt_irrefl 0)

/-- The article's search interval, lower end. -/
noncomputable def searchLo : ℝ := 2 * Real.arcsin (Real.sin (π / 64) / 2)
/-- The article's search interval, upper end. -/
noncomputable def searchHi : ℝ := π / 64

/-- `cos(π/64)`, bounded through Mathlib's nested radical. -/
lemma cos_searchHi : ((998795456205172392714771/1000000000000000000000000) : ℝ) < Real.cos searchHi ∧ Real.cos searchHi < (249698864051293098178693/250000000000000000000000) := by
  have e : searchHi = π / 2 ^ (5 + 1) := by unfold searchHi; norm_num
  rw [e, Real.cos_pi_over_two_pow]
  simp only [Real.sqrtTwoAddSeries, add_zero]
  have hl1 : ((176776695296636881100211/125000000000000000000000) : ℝ) < √2 := by
    rw [Real.lt_sqrt (by norm_num)]
    norm_num
  have hu1 : √2 < ((1414213562373095048801689/1000000000000000000000000) : ℝ) := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num
  have hl2 : ((923879532511286756128183/500000000000000000000000) : ℝ) < √(2 + √2) := by
    rw [Real.lt_sqrt (by norm_num)]
    have : ((923879532511286756128183/500000000000000000000000) : ℝ) ^ 2 < 2 + (176776695296636881100211/125000000000000000000000) := by norm_num
    linarith [hl1]
  have hu2 : √(2 + √2) < ((1847759065022573512256367/1000000000000000000000000) : ℝ) := by
    rw [Real.sqrt_lt' (by norm_num)]
    have : 2 + (1414213562373095048801689/1000000000000000000000000) < ((1847759065022573512256367/1000000000000000000000000) : ℝ) ^ 2 := by norm_num
    linarith [hu1]
  have hl3 : ((490392640201615224563091/250000000000000000000000) : ℝ) < √(2 + √(2 + √2)) := by
    rw [Real.lt_sqrt (by norm_num)]
    have : ((490392640201615224563091/250000000000000000000000) : ℝ) ^ 2 < 2 + (923879532511286756128183/500000000000000000000000) := by norm_num
    linarith [hl2]
  have hu3 : √(2 + √(2 + √2)) < ((392314112161292179650473/200000000000000000000000) : ℝ) := by
    rw [Real.sqrt_lt' (by norm_num)]
    have : 2 + (1847759065022573512256367/1000000000000000000000000) < ((392314112161292179650473/200000000000000000000000) : ℝ) ^ 2 := by norm_num
    linarith [hu2]
  have hl4 : ((1990369453344393772489673/1000000000000000000000000) : ℝ) < √(2 + √(2 + √(2 + √2))) := by
    rw [Real.lt_sqrt (by norm_num)]
    have : ((1990369453344393772489673/1000000000000000000000000) : ℝ) ^ 2 < 2 + (490392640201615224563091/250000000000000000000000) := by norm_num
    linarith [hl3]
  have hu4 : √(2 + √(2 + √(2 + √2))) < ((79614778133775750899587/40000000000000000000000) : ℝ) := by
    rw [Real.sqrt_lt' (by norm_num)]
    have : 2 + (392314112161292179650473/200000000000000000000000) < ((79614778133775750899587/40000000000000000000000) : ℝ) ^ 2 := by norm_num
    linarith [hu3]
  have hl5 : ((998795456205172392714771/500000000000000000000000) : ℝ) < √(2 + √(2 + √(2 + √(2 + √2)))) := by
