/-- **`I_eq ⊆ R_eq`, by a Henneberg construction.** Pin the first side by a rigid
motion; then every other vertex is pinned in turn by two bars with independent
directions (`henD_*`). The displacement minus the rigid motion vanishes. -/
theorem Ieq_imp_R (z : ℝ) (hsz : 0 < Real.sin z) (h₁ : clo ≤ Real.cos z) (h₂ : Real.cos z ≤ chi)
    (hl : L z ≠ 0) (w : Cfg 64) (h : (dataOf (P z) (L z) ea eb).Ieq w 0) :
    (dataOf (P z) (L z) ea eb).R w := by
  obtain ⟨hs, hd⟩ := bars_of_Ieq hl h
  have hne : P z (0 : Fin 64) ≠ P z (1 : Fin 64) := by
    intro heq
    have := convexOrdered z hsz h₁ h₂ (0 : Fin 64) (2 : Fin 64) (by decide) (by decide)
    rw [succ_0, heq] at this
    simp [cross_eq] at this
  have hb01 := hs (0 : Fin 64)
  rw [succ_0] at hb01
  obtain ⟨t, ω, h0, h1⟩ := pin_bar hne hb01
  set w' : Cfg 64 := fun k => w k - (t + ω • J (P z k)) with hw'
  have z0 : w' (0 : Fin 64) = 0 := by simp only [hw', h0, sub_self]
  have z1 : w' (1 : Fin 64) = 0 := by simp only [hw', h1, sub_self]
  have z33 : w' (33 : Fin 64) = 0 := by
    apply henneberg_step (Pi := P z (0 : Fin 64)) (Pj := P z (1 : Fin 64)) (wi := w' (0 : Fin 64)) (wj := w' (1 : Fin 64))
      (bar_sub_rigid (t := t) (ω := ω) (by have := hd (2 : Fin 63); rw [ea_2, eb_2] at this; exact this)) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (3 : Fin 63); rw [ea_3, eb_3] at this; exact this)) z0 z1
    rw [P_33, P_0, P_1, det_reduced]
    exact (mul_pos hsz (henD_33 _ h₁ h₂)).ne'
  have z32 : w' (32 : Fin 64) = 0 := by
    apply henneberg_step (Pi := P z (33 : Fin 64)) (Pj := P z (0 : Fin 64)) (wi := w' (33 : Fin 64)) (wj := w' (0 : Fin 64))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (32 : Fin 64); rw [succ_32] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (1 : Fin 63); rw [ea_1, eb_1] at this; exact this)) z33 z0
