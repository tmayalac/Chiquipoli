theorem bal_17 (c : ℝ) (h₁ : clo ≤ c) (h₂ : c ≤ chi) : BX17 c = 0 ∧ BY17 c = 0 := by
  have hD := (henD_17 c h₁ h₂).ne'
  obtain ⟨h1, h2⟩ := cramer_bal (F1 := (((st16 c * (XC16 c - XC17 c)) + (st17 c * (XC18 c - XC17 c))) + (st36 c * (XC2 c - XC17 c)))) (F2 := (((st16 c * (YC16 c - YC17 c)) + (st17 c * (YC18 c - YC17 c))) + (st36 c * (YC2 c - YC17 c))))
    (a1 := (XC0 c - XC17 c)) (a2 := (YC0 c - YC17 c)) (b1 := (XC1 c - XC17 c)) (b2 := (YC1 c - YC17 c)) hD
  unfold BX17 BY17 st34 st35
  exact ⟨by linear_combination h1, by linear_combination h2⟩

theorem bal_16 (c : ℝ) (h₁ : clo ≤ c) (h₂ : c ≤ chi) : BX16 c = 0 ∧ BY16 c = 0 := by
