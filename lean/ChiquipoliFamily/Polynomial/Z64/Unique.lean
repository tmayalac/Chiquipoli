noncomputable def dxx (c : ℝ) : ℝ := da c + (-c / sn c) * pl4 c + sn c * dpl4 c - 1
noncomputable def ww (c : ℝ) : ℝ := pl5 c - sn c - rr c
noncomputable def Gd (c : ℝ) : ℝ :=
  2 * xx c * dxx c + 2 * ww c * (dpl5 c + c / sn c - dr c / (2 * rr c)) + 2

