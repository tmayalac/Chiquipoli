noncomputable def aa (c : ℝ) : ℝ := sn c * pl1 c + 1 / 2
noncomputable def da (c : ℝ) : ℝ := (-c / sn c) * pl1 c + sn c * dpl1 c
noncomputable def Nf (c : ℝ) : ℝ := -c * pl1 c + (1 - c ^ 2) * dpl1 c
noncomputable def dr (c : ℝ) : ℝ := -2 - 2 * aa c * da c
