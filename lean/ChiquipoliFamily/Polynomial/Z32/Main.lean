/-- **`I_eq ⊆ R_eq`, by a Henneberg construction.** Pin the first side by a rigid
motion; then every other vertex is pinned in turn by two bars with independent
directions (`henD_*`). The displacement minus the rigid motion vanishes. -/
theorem Ieq_imp_R (z : ℝ) (hsz : 0 < Real.sin z) (h₁ : clo ≤ Real.cos z) (h₂ : Real.cos z ≤ chi)
    (hl : L z ≠ 0) (w : Cfg 32) (h : (dataOf (P z) (L z) ea eb).Ieq w 0) :
    (dataOf (P z) (L z) ea eb).R w := by
  obtain ⟨hs, hd⟩ := bars_of_Ieq hl h
  have hne : P z (0 : Fin 32) ≠ P z (1 : Fin 32) := by
    intro heq
    have := convexOrdered z hsz h₁ h₂ (0 : Fin 32) (2 : Fin 32) (by decide) (by decide)
    rw [succ_0, heq] at this
    simp [cross_eq] at this
  have hb01 := hs (0 : Fin 32)
  rw [succ_0] at hb01
  obtain ⟨t, ω, h0, h1⟩ := pin_bar hne hb01
  set w' : Cfg 32 := fun k => w k - (t + ω • J (P z k)) with hw'
  have z0 : w' (0 : Fin 32) = 0 := by simp only [hw', h0, sub_self]
  have z1 : w' (1 : Fin 32) = 0 := by simp only [hw', h1, sub_self]
  have z21 : w' (21 : Fin 32) = 0 := by
    apply henneberg_step (Pi := P z (0 : Fin 32)) (Pj := P z (1 : Fin 32)) (wi := w' (0 : Fin 32)) (wj := w' (1 : Fin 32))
      (bar_sub_rigid (t := t) (ω := ω) (by have := hd (10 : Fin 31); rw [ea_10, eb_10] at this; exact this)) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (11 : Fin 31); rw [ea_11, eb_11] at this; exact this)) z0 z1
    rw [P_21, P_0, P_1, det_reduced]
    exact (mul_pos hsz (henD_21 _ h₁ h₂)).ne'
  have z20 : w' (20 : Fin 32) = 0 := by
    apply henneberg_step (Pi := P z (21 : Fin 32)) (Pj := P z (0 : Fin 32)) (wi := w' (21 : Fin 32)) (wj := w' (0 : Fin 32))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (20 : Fin 32); rw [succ_20] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (9 : Fin 31); rw [ea_9, eb_9] at this; exact this)) z21 z0
    rw [P_20, P_21, P_0, det_reduced]
    exact (mul_pos hsz (henD_20 _ h₁ h₂)).ne'
  have z19 : w' (19 : Fin 32) = 0 := by
    apply henneberg_step (Pi := P z (20 : Fin 32)) (Pj := P z (0 : Fin 32)) (wi := w' (20 : Fin 32)) (wj := w' (0 : Fin 32))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (19 : Fin 32); rw [succ_19] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (8 : Fin 31); rw [ea_8, eb_8] at this; exact this)) z20 z0
    rw [P_19, P_20, P_0, det_reduced]
    exact (mul_pos hsz (henD_19 _ h₁ h₂)).ne'
  have z18 : w' (18 : Fin 32) = 0 := by
    apply henneberg_step (Pi := P z (19 : Fin 32)) (Pj := P z (0 : Fin 32)) (wi := w' (19 : Fin 32)) (wj := w' (0 : Fin 32))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (18 : Fin 32); rw [succ_18] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (7 : Fin 31); rw [ea_7, eb_7] at this; exact this)) z19 z0
    rw [P_18, P_19, P_0, det_reduced]
    exact (mul_pos hsz (henD_18 _ h₁ h₂)).ne'
  have z17 : w' (17 : Fin 32) = 0 := by
    apply henneberg_step (Pi := P z (18 : Fin 32)) (Pj := P z (0 : Fin 32)) (wi := w' (18 : Fin 32)) (wj := w' (0 : Fin 32))
      (bar_flip (bar_sub_rigid (t := t) (ω := ω) (by have := hs (17 : Fin 32); rw [succ_17] at this; exact this))) (bar_sub_rigid (t := t) (ω := ω) (by have := hd (6 : Fin 31); rw [ea_6, eb_6] at this; exact this)) z18 z0
    rw [P_17, P_18, P_0, det_reduced]
