/-- `4 sin²(z/2) = 2 − 2 cos z`. -/
lemma four_sin_sq_half (z : ℝ) : 4 * sin (z / 2) ^ 2 = 2 - 2 * cos z := by
  have h2 : (2 : ℝ) * (z / 2) = z := by ring
  have hc := Cheb.cos_2 (z / 2)
  rw [h2] at hc
  linear_combination 4 * Cheb.pyth (z / 2) + 2 * hc

/-- Upstream's constructor equation is `268435456 · Fc (cos z)` wherever `cos 2z ≠ 0`. -/
theorem F_eq (z : ℝ) (hD : cos (2 * z) ≠ 0) : Optigon.F 32 z = 268435456 * Fc (cos z) := by
  have e1 : ((((32 : ℕ) : ℝ)) / 4 - 2) * z = 6 * z := by push_cast; ring
  have e2 : ((32 : ℕ) : ℝ) * z / 4 = 8 * z := by push_cast; ring
  have e3 : ((((32 : ℕ) : ℝ)) / 2 - 1) * z = 15 * z := by push_cast; ring
  simp only [Optigon.F, Optigon.x]
  rw [e1, e2, e3, four_sin_sq_half]
  rw [Cheb.cos_2] at hD
  simp only [Cheb.sin_2, Cheb.cos_2, Cheb.sin_3, Cheb.cos_3, Cheb.sin_4, Cheb.cos_4, Cheb.sin_5, Cheb.cos_5, Cheb.sin_6, Cheb.cos_6, Cheb.sin_7, Cheb.cos_7, Cheb.sin_8, Cheb.cos_8, Cheb.sin_9, Cheb.cos_9, Cheb.sin_10, Cheb.cos_10, Cheb.sin_11, Cheb.cos_11, Cheb.sin_12, Cheb.cos_12, Cheb.sin_13, Cheb.cos_13, Cheb.sin_14, Cheb.cos_14, Cheb.sin_15, Cheb.cos_15, Cheb.sin_16, Cheb.cos_16]
  unfold Fc
  generalize hDv : 2 * cos z ^ 2 - 1 = D at hD ⊢
  first | ring1 | (field_simp <;> (try rw [← hDv]) <;> first | ring1 | (simp; done) | (ring_nf <;> simp only [sin_sq] <;> ring_nf))

