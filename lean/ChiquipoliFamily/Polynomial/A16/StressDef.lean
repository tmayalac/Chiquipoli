  obtain ⟨x8, y8⟩ := bal_8 c h₁ h₂
  obtain ⟨x7, y7⟩ := bal_7 c h₁ h₂
  obtain ⟨x15, y15⟩ := bal_15 c h₁ h₂
  obtain ⟨x14, y14⟩ := bal_14 c h₁ h₂
  obtain ⟨x2, y2⟩ := bal_2 c h₁ h₂
  obtain ⟨x10, y10⟩ := bal_10 c h₁ h₂
  obtain ⟨x6, y6⟩ := bal_6 c h₁ h₂
  obtain ⟨x13, y13⟩ := bal_13 c h₁ h₂
  obtain ⟨x3, y3⟩ := bal_3 c h₁ h₂
  obtain ⟨x11, y11⟩ := bal_11 c h₁ h₂
  obtain ⟨x12, y12⟩ := bal_12 c h₁ h₂
  obtain ⟨x5, y5⟩ := bal_5 c h₁ h₂
  obtain ⟨x4, y4⟩ := bal_4 c h₁ h₂
  have gX : BX0 c + BX1 c + BX2 c + BX3 c + BX4 c + BX5 c + BX6 c + BX7 c + BX8 c + BX9 c + BX10 c + BX11 c + BX12 c + BX13 c + BX14 c + BX15 c = 0 := by
    unfold BX0 BX1 BX2 BX3 BX4 BX5 BX6 BX7 BX8 BX9 BX10 BX11 BX12 BX13 BX14 BX15; ring
  have gY : BY0 c + BY1 c + BY2 c + BY3 c + BY4 c + BY5 c + BY6 c + BY7 c + BY8 c + BY9 c + BY10 c + BY11 c + BY12 c + BY13 c + BY14 c + BY15 c = 0 := by
    unfold BY0 BY1 BY2 BY3 BY4 BY5 BY6 BY7 BY8 BY9 BY10 BY11 BY12 BY13 BY14 BY15; ring
  have gM : (XC0 c * BY0 c - YC0 c * BX0 c) + (XC1 c * BY1 c - YC1 c * BX1 c) + (XC2 c * BY2 c - YC2 c * BX2 c) + (XC3 c * BY3 c - YC3 c * BX3 c) + (XC4 c * BY4 c - YC4 c * BX4 c) + (XC5 c * BY5 c - YC5 c * BX5 c) + (XC6 c * BY6 c - YC6 c * BX6 c) + (XC7 c * BY7 c - YC7 c * BX7 c) + (XC8 c * BY8 c - YC8 c * BX8 c) + (XC9 c * BY9 c - YC9 c * BX9 c) + (XC10 c * BY10 c - YC10 c * BX10 c) + (XC11 c * BY11 c - YC11 c * BX11 c) + (XC12 c * BY12 c - YC12 c * BX12 c) + (XC13 c * BY13 c - YC13 c * BX13 c) + (XC14 c * BY14 c - YC14 c * BX14 c) + (XC15 c * BY15 c - YC15 c * BX15 c) = 0 := by
    unfold BX0 BY0 BX1 BY1 BX2 BY2 BX3 BY3 BX4 BY4 BX5 BY5 BX6 BY6 BX7 BY7 BX8 BY8 BX9 BY9 BX10 BY10 BX11 BY11 BX12 BY12 BX13 BY13 BX14 BY14 BX15 BY15; ring
  have z0 : XC0 c = 0 := by unfold XC0; rfl
  have w0 : YC0 c = 0 := by unfold YC0; rfl
  have hx1 : 0 < XC1 c := pos_of_close (encX1 c h₁ h₂) (by norm_num [rho])
  have hu : (XC0 c - XC1 c) * (XC0 c - XC1 c) + (YC0 c - YC1 c) * (YC0 c - YC1 c) ≠ 0 := by
    rw [z0]; exact ne_of_gt (add_pos_of_pos_of_nonneg (mul_pos_of_neg_of_neg (sub_neg.mpr hx1) (sub_neg.mpr hx1)) (mul_self_nonneg _))
  have hpin : BX1 c * (XC0 c - XC1 c) + BY1 c * (YC0 c - YC1 c) = 0 := by
    have h := pin_bal (G1 := ((st1 c * (XC2 c - XC1 c)) + (st19 c * (XC9 c - XC1 c)))) (G2 := ((st1 c * (YC2 c - YC1 c)) + (st19 c * (YC9 c - YC1 c)))) (u1 := (XC0 c - XC1 c)) (u2 := (YC0 c - YC1 c)) hu
    unfold BX1 BY1 st0
    linear_combination h
  rw [z0, w0] at hpin
  have e1 : BX0 c + BX1 c = 0 := by linear_combination gX - x9 - x8 - x7 - x15 - x14 - x2 - x10 - x6 - x13 - x3 - x11 - x12 - x5 - x4
  have e2 : BY0 c + BY1 c = 0 := by linear_combination gY - y9 - y8 - y7 - y15 - y14 - y2 - y10 - y6 - y13 - y3 - y11 - y12 - y5 - y4
  have e3 : XC1 c * BY1 c - YC1 c * BX1 c = 0 := by
    linear_combination gM - (XC9 c * y9 - YC9 c * x9) - (XC8 c * y8 - YC8 c * x8) - (XC7 c * y7 - YC7 c * x7) - (XC15 c * y15 - YC15 c * x15) - (XC14 c * y14 - YC14 c * x14) - (XC2 c * y2 - YC2 c * x2) - (XC10 c * y10 - YC10 c * x10) - (XC6 c * y6 - YC6 c * x6) - (XC13 c * y13 - YC13 c * x13) - (XC3 c * y3 - YC3 c * x3) - (XC11 c * y11 - YC11 c * x11) - (XC12 c * y12 - YC12 c * x12) - (XC5 c * y5 - YC5 c * x5) - (XC4 c * y4 - YC4 c * x4) - BY0 c * z0 + BX0 c * w0
  have hne : XC1 c ^ 2 + YC1 c ^ 2 ≠ 0 := ne_of_gt (add_pos_of_pos_of_nonneg (pow_pos hx1 2) (sq_nonneg _))
  have hb1x : BX1 c = 0 := by
    have hq : (XC1 c ^ 2 + YC1 c ^ 2) * BX1 c = 0 := by
      linear_combination (-(XC1 c)) * hpin - (YC1 c) * e3
    exact (mul_eq_zero.mp hq).resolve_left hne
  have hb1y : BY1 c = 0 := by
    have hq : (XC1 c ^ 2 + YC1 c ^ 2) * BY1 c = 0 := by
      linear_combination (-(YC1 c)) * hpin + (XC1 c) * e3
    exact (mul_eq_zero.mp hq).resolve_left hne
  exact ⟨by linear_combination e1 - hb1x, by linear_combination e2 - hb1y, hb1x, hb1y⟩

