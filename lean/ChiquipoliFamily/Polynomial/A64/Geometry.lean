lemma pyth (z : ℝ) : Real.sin z ^ 2 = 1 - Real.cos z ^ 2 := by
  linear_combination Real.sin_sq_add_cos_sq z

/-- The side length `ℓ = 2 sin(z/2)`. -/
noncomputable def L (z : ℝ) : ℝ := 2 * Real.sin (z / 2)

