    term_nonneg hu hv 2 1 (by norm_num)
  have t3 : (0:ℝ) ≤ (105281126419862401/125000000000000000) * (c - clo) ^ 3 * (chi - c) ^ 0 :=
    term_nonneg hu hv 3 0 (by norm_num)
  have hsum : (0:ℝ) ≤ (1 - ((1 - c ^ 2) * (XC15 c - XC13 c) ^ 2 + (YC15 c - YC13 c) ^ 2) - (1/100)) * (chi - clo) ^ 3 := by
    rw [key]; exact add_nonneg (add_nonneg (add_nonneg (t0) t1) t2) t3
  -- Deterministic: strip the positive factor `h^n`. `nlinarith` also closes
  -- this, but it searches Positivstellensatz products of degree-3 terms with
  -- 60-digit coefficients and blows the heartbeat budget.
  linarith [(mul_nonneg_iff_of_pos_right hh).mp hsum]

end Chiquipoli
