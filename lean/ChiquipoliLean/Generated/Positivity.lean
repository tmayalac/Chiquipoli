/-- **The root is unique in the bracket.** Together with `Fc_root_exists`
this upgrades existence to existence-and-uniqueness there. -/
theorem Fc_root_unique {x y : ℝ} (hx : x ∈ Set.Icc clo chi) (hy : y ∈ Set.Icc clo chi)
    (hfx : Fc x = 0) (hfy : Fc y = 0) : x = y := by
  rcases lt_trichotomy x y with h | h | h
  · have := Fc_strictMonoOn hx hy h; rw [hfx, hfy] at this; exact absurd this (lt_irrefl 0)
  · exact h
  · have := Fc_strictMonoOn hy hx h; rw [hfx, hfy] at this; exact absurd this (lt_irrefl 0)

/-- **Existence and uniqueness of the constructor root in the bracket.** -/
