  refine strictMonoOn_of_deriv_pos (convex_Icc _ _) Fc_continuous.continuousOn ?_
  intro x hx
  rw [interior_Icc] at hx
  rw [deriv_Fc]
  have := dFc_lower_bound_wide x (le_of_lt hx.1) (le_of_lt hx.2)
  linarith

/-- **The constructor root is unique across the entire search interval.** -/
theorem Fc_root_unique_search {x y : ℝ} (hx : x ∈ Set.Icc slo shi)
    (hy : y ∈ Set.Icc slo shi) (hfx : Fc x = 0) (hfy : Fc y = 0) : x = y := by
  rcases lt_trichotomy x y with h | h | h
  · have := Fc_strictMonoOn_search hx hy h; rw [hfx, hfy] at this
    exact absurd this (lt_irrefl 0)
  · exact h
  · have := Fc_strictMonoOn_search hy hx h; rw [hfx, hfy] at this
    exact absurd this (lt_irrefl 0)

/-- **Existence and uniqueness across the whole search interval** — this is the
full strength of Prop 6.2(1), no longer only inside the narrow bracket. -/
theorem Fc_root_existsUnique_search : ∃! c, c ∈ Set.Icc slo shi ∧ Fc c = 0 := by
  obtain ⟨c, hc, hfc⟩ := Fc_root_exists
  have hmem : c ∈ Set.Icc slo shi :=
    ⟨le_trans slo_le_clo (le_of_lt hc.1), le_trans (le_of_lt hc.2) chi_le_shi⟩
  refine ⟨c, ⟨hmem, hfc⟩, ?_⟩
  rintro y ⟨hy, hfy⟩
  exact Fc_root_unique_search hy hmem hfy hfc

/-- The same statement one level up, for the parameter `z` itself: `cos` is
injective on `[0,1] ⊆ [0,π]`, so a unique `c` gives a unique `z`. The paper's
search range `(0.1954, 0.19635)` sits inside `[0,1]`. -/
theorem constructor_root_unique_in_search {z₁ z₂ : ℝ}
    (hz₁ : z₁ ∈ Set.Icc (0:ℝ) 1) (hz₂ : z₂ ∈ Set.Icc (0:ℝ) 1)
    (hc₁ : Real.cos z₁ ∈ Set.Icc slo shi) (hc₂ : Real.cos z₂ ∈ Set.Icc slo shi)
    (hf₁ : Ffun z₁ = 0) (hf₂ : Ffun z₂ = 0) : z₁ = z₂ := by
  have hpi : (1:ℝ) ≤ Real.pi := by
    have := Real.pi_gt_three; linarith
  have hsub : Set.Icc (0:ℝ) 1 ⊆ Set.Icc 0 Real.pi :=
    Set.Icc_subset_Icc le_rfl hpi
  have hcos : Real.cos z₁ = Real.cos z₂ := by
    have e₁ : Fc (Real.cos z₁) = 0 := by rw [Fc_cos_eq_Ffun]; exact hf₁
    have e₂ : Fc (Real.cos z₂) = 0 := by rw [Fc_cos_eq_Ffun]; exact hf₂
    exact Fc_root_unique_search hc₁ hc₂ e₁ e₂
  exact Real.injOn_cos (hsub hz₁) (hsub hz₂) hcos

