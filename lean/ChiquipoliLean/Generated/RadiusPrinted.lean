/-- The unit form at `phR`: a quarter of the full `Qform` plus a multiple of
its side-and-rigid part, in the variable `dt = 2·LU1·y`. -/
theorem QhatU_eq (v : Fin 16 → ℝ × ℝ) (y : ℝ) :
    (1 / 4) * Qform phR radA radB v (2 * ((3919/20000) : ℝ) * y)
      + (1 / (4 * ((4899/25000) : ℝ) ^ 2) - 1 / 4) * Qform phR prE0 prE0 v (2 * ((3919/20000) : ℝ) * y)
      = ∑ k, (∑ i, (ChatU k i : ℝ) * flat v y i) ^ 2 := by
  rw [Qform, Qform, sum16r (fun i => Feasible.sideRow phR v (2 * ((3919/20000) : ℝ) * y) i ^ 2),
    sum15r (fun e => Feasible.diamRow phR radA radB v e ^ 2), Fin.sum_univ_zero,
    sum34r (fun k => (∑ i, (ChatU k i : ℝ) * flat v y i) ^ 2)]
  rw [chatU_row_0, chatU_row_1, chatU_row_2, chatU_row_3, chatU_row_4, chatU_row_5, chatU_row_6, chatU_row_7, chatU_row_8, chatU_row_9, chatU_row_10, chatU_row_11, chatU_row_12, chatU_row_13, chatU_row_14, chatU_row_15, chatU_row_16, chatU_row_17, chatU_row_18, chatU_row_19, chatU_row_20, chatU_row_21, chatU_row_22, chatU_row_23, chatU_row_24, chatU_row_25, chatU_row_26, chatU_row_27, chatU_row_28, chatU_row_29, chatU_row_30, chatU_row_31, chatU_row_32, chatU_row_33]
  ring

/-- **The Gram bound at `phR` for the unit Jacobian.** -/
theorem QhatU_lower (v : Fin 16 → ℝ × ℝ) (y : ℝ) :
    (((919/10000) - (1/1000000000000) : ℚ) : ℝ) * (cip v v + y ^ 2) ≤
      (1 / 4) * Qform phR radA radB v (2 * ((3919/20000) : ℝ) * y)
        + (1 / (4 * ((4899/25000) : ℝ) ^ 2) - 1 / 4) * Qform phR prE0 prE0 v (2 * ((3919/20000) : ℝ) * y) := by
  have h := gram_lower ChatU LqU dqU ((919/10000)) ((1/1000000000000)) dqU_nonneg gram_rowsU (flat v y)
  rw [flat_sq] at h
  rw [QhatU_eq]
  exact h

