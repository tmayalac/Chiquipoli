still exceeds the printed `σ² = 0.09119`. -/
lemma coerU_arith :
    ((9119/100000) : ℝ) ≤ (1 - ((1/500) : ℝ)) * ((((919/10000) - (1/1000000000000) : ℚ) : ℝ))
      - (1 / ((1/500) : ℝ) - 1) * ((1 / 4) * 2080 + (1 / (4 * ((4899/25000) : ℝ) ^ 2) - 1 / 4) * 160) * radEps ^ 2 := by
  unfold radEps; norm_num

