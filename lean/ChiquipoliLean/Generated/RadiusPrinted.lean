    unfold prLo prHi; norm_num
  have key : (nA0 c - (-6864636312291132279/100000000000000000000)) * (prHi - prLo) ^ 11 =
      () * (c - prLo) ^ 0 * (prHi - c) ^ 11 +
        () * (c - prLo) ^ 1 * (prHi - c) ^ 10 +
        () * (c - prLo) ^ 2 * (prHi - c) ^ 9 +
        () * (c - prLo) ^ 3 * (prHi - c) ^ 8 +
        () * (c - prLo) ^ 4 * (prHi - c) ^ 7 +
        () * (c - prLo) ^ 5 * (prHi - c) ^ 6 +
        () * (c - prLo) ^ 6 * (prHi - c) ^ 5 +
        () * (c - prLo) ^ 7 * (prHi - c) ^ 4 +
        () * (c - prLo) ^ 8 * (prHi - c) ^ 3 +
        () * (c - prLo) ^ 9 * (prHi - c) ^ 2 +
        () * (c - prLo) ^ 10 * (prHi - c) ^ 1 +
        () * (c - prLo) ^ 11 * (prHi - c) ^ 0 := by
    unfold prLo prHi nA0; ring
  have t0 : (0:ℝ) ≤ () * (c - prLo) ^ 0 * (prHi - c) ^ 11 :=
    term_nonneg hu hv 0 11 (by norm_num)
  have t1 : (0:ℝ) ≤ () * (c - prLo) ^ 1 * (prHi - c) ^ 10 :=
    term_nonneg hu hv 1 10 (by norm_num)
