lemma p0_enc (z : ℝ) (hs1 : radS1 ≤ Real.sin z) (hs2 : Real.sin z ≤ radS2)
    (h₁ : clo ≤ Real.cos z) (h₂ : Real.cos z ≤ chi) :
    |(p0 z - phR 0).1| ≤ radEps ∧ |(p0 z - phR 0).2| ≤ radEps := by
  have hxl := XC0_lo (Real.cos z) h₁ h₂
  have hxh := XC0_hi (Real.cos z) h₁ h₂
  have hyl := YC0_lo (Real.cos z) h₁ h₂
  have hyh := YC0_hi (Real.cos z) h₁ h₂
  rw [red0]
  refine ⟨?_, ?_⟩
  · exact enclose_mul (s1 := radS1) (s2 := radS2) (xh := (0 : ℝ))
      (by unfold radS1; norm_num) hs1 hs2 hxl
      (show XC0 (Real.cos z) ≤ ((1/1000000000000) : ℝ) by linarith)
      (by unfold radS1 radEps; norm_num) (by unfold radS2 radEps; norm_num)
      (by unfold radS1 radEps; norm_num) (by unfold radS2 radEps; norm_num)
  · exact enclose_one (yh := (0 : ℝ)) hyl
      (show YC0 (Real.cos z) ≤ ((1/1000000000000) : ℝ) by linarith)
