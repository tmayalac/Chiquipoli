/-- **Stationarity at every vertex.** -/
theorem stationarity_vertex (z : ℝ) (hF : Ffun z = 0) (k : Fin 16) :
    gradSum k z = (0, 0) := by
  fin_cases k
  · exact congrArg₂ Prod.mk (gradx_0 z hF) (grady_0 z hF)
  · exact congrArg₂ Prod.mk (gradx_1 z hF) (grady_1 z hF)
  · exact congrArg₂ Prod.mk (gradx_2 z hF) (grady_2 z hF)
  · exact congrArg₂ Prod.mk (gradx_3 z hF) (grady_3 z hF)
  · exact congrArg₂ Prod.mk (gradx_4 z hF) (grady_4 z hF)
  · exact congrArg₂ Prod.mk (gradx_5 z hF) (grady_5 z hF)
  · exact congrArg₂ Prod.mk (gradx_6 z hF) (grady_6 z hF)
  · exact congrArg₂ Prod.mk (gradx_7 z hF) (grady_7 z hF)
  · exact congrArg₂ Prod.mk (gradx_8 z hF) (grady_8 z hF)
  · exact congrArg₂ Prod.mk (gradx_9 z hF) (grady_9 z hF)
  · exact congrArg₂ Prod.mk (gradx_10 z hF) (grady_10 z hF)
  · exact congrArg₂ Prod.mk (gradx_11 z hF) (grady_11 z hF)
  · exact congrArg₂ Prod.mk (gradx_12 z hF) (grady_12 z hF)
  · exact congrArg₂ Prod.mk (gradx_13 z hF) (grady_13 z hF)
  · exact congrArg₂ Prod.mk (gradx_14 z hF) (grady_14 z hF)
  · exact congrArg₂ Prod.mk (gradx_15 z hF) (grady_15 z hF)

/-- **Prop 6.2(5), assembled.** At the constructor root there are multipliers
for the sixteen side constraints and the fifteen active-diameter constraints
such that

  * the weighted sum of constraint gradients vanishes at every vertex,
  * the `t`-direction equation `Σ α_i = -1` holds, and
  * every active-diameter multiplier is **strictly positive**.

Together these are the stationarity identity with strictly positive active
multipliers that Theorem 3.5 requires. Note this does *not* require LICQ — the
active Jacobian has rank 30, not 31 — only that some such multiplier vector
exists, which is what is exhibited here. -/
theorem multipliers_certified (z : ℝ) (hF : Ffun z = 0)
    (hc : Real.cos z ∈ Set.Ioo clo chi) :
    (∀ k : Fin 16, gradSum k z = (0, 0)) ∧
    (mA0 (Real.cos z) + mA1 (Real.cos z) + mA2 (Real.cos z) + mA3 (Real.cos z) + mA4 (Real.cos z) + mA5 (Real.cos z) + mA6 (Real.cos z) + mA7 (Real.cos z) + mA8 (Real.cos z) + mA9 (Real.cos z) + mA10 (Real.cos z) + mA11 (Real.cos z) + mA12 (Real.cos z) + mA13 (Real.cos z) + mA14 (Real.cos z) + mA15 (Real.cos z) = -1) ∧
    (0 < mL0 (Real.cos z) ∧ 0 < mL1 (Real.cos z) ∧ 0 < mL2 (Real.cos z) ∧ 0 < mL3 (Real.cos z) ∧ 0 < mL4 (Real.cos z) ∧ 0 < mL5 (Real.cos z) ∧ 0 < mL6 (Real.cos z) ∧ 0 < mL7 (Real.cos z) ∧ 0 < mL8 (Real.cos z) ∧ 0 < mL9 (Real.cos z) ∧ 0 < mL10 (Real.cos z) ∧ 0 < mL11 (Real.cos z) ∧ 0 < mL12 (Real.cos z) ∧ 0 < mL13 (Real.cos z) ∧ 0 < mL14 (Real.cos z)) := by
  refine ⟨stationarity_vertex z hF, alpha_sum _, ?_⟩
  refine ⟨by linarith [mL0_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL1_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL2_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL3_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL4_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL5_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL6_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL7_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL8_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL9_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL10_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL11_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL12_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL13_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)], by linarith [mL14_pos (Real.cos z) (le_of_lt hc.1) (le_of_lt hc.2)]⟩

end Chiquipoli
