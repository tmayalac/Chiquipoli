identically, so this holds for *arbitrary* `a b e`. -/
theorem Eg1 (z a b e dt : ℝ) (w : Fin 16 → ℝ × ℝ)
    (h : dsq (p0 z) (p1 z) (w 0) (w 1) = dt) :
    ((2) * Real.cos z + (-1)) * (Real.sin z * ((w 1).1 - (a - e * (p1 z).2))) +
        ((-1)) * (dt / 2) +
