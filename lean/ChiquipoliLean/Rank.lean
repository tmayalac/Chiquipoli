/-- `XC1_lower`: Bernstein certificate, all 2 coefficients ≥ 0.9. -/
lemma XC1_lower (c : ℝ) (h₁ : clo ≤ c) (h₂ : c ≤ chi) :
    (9/10) ≤ XC1 c := by
  have hu : (0:ℝ) ≤ c - clo := by linarith
  have hv : (0:ℝ) ≤ chi - c := by linarith
  have hh : (0:ℝ) < (chi - clo) ^ 1 := by
    unfold clo chi; norm_num
  have key : (XC1 c - (9/10)) * (chi - clo) ^ 1 =
      (77/1250) * (c - clo) ^ 0 * (chi - c) ^ 1 +
        (30801/500000) * (c - clo) ^ 1 * (chi - c) ^ 0 := by
    unfold clo chi XC1; ring
  have t0 : (0:ℝ) ≤ (77/1250) * (c - clo) ^ 0 * (chi - c) ^ 1 :=
    term_nonneg hu hv 0 1 (by norm_num)
  have t1 : (0:ℝ) ≤ (30801/500000) * (c - clo) ^ 1 * (chi - c) ^ 0 :=
    term_nonneg hu hv 1 0 (by norm_num)
  have hsum : (0:ℝ) ≤ (XC1 c - (9/10)) * (chi - clo) ^ 1 := by
    rw [key]; exact add_nonneg (t0) t1
  -- Deterministic: strip the positive factor `h^n`. `nlinarith` also closes
  -- this, but it searches Positivstellensatz products of degree-1 terms with
  -- 60-digit coefficients and blows the heartbeat budget.
  linarith [(mul_nonneg_iff_of_pos_right hh).mp hsum]

/-- `(p₁)¹ ≠ 0`. This is what makes the three rigid motions independent on the
free coordinates `x₀, y₀, y₁`, and hence what lets `a, b, e` be solved for. -/
theorem p1_fst_ne (z : ℝ) (hsz : 0 < Real.sin z)
    (hcb : Real.cos z ∈ Set.Ioo clo chi) : (p1 z).1 ≠ 0 := by
  rw [red1]
  have h := XC1_lower (Real.cos z) (le_of_lt hcb.1) (le_of_lt hcb.2)
  have : (0:ℝ) < Real.sin z * XC1 (Real.cos z) := by positivity
  simpa using ne_of_gt this

