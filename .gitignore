# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local settings / agent state
.claude/

# Julia
/*.jl.cov
/*.jl.*.cov
/*.jl.mem

# Lean / Lake build artifacts and the vendored Mathlib checkout (~7 GB).
# `lean/lake-manifest.json` pins the exact Mathlib revision, so the build is
# reproducible without committing any of this.
lean/.lake/
lean/lakefile.olean

# The article is not public. Its working copies live at the repository root
# (main.tex, main_1.tex, supplement.tex and their PDFs) and none of them is
# part of the released artifact. Anchored with a leading slash on purpose: a
# bare `*.tex` would also swallow results/tables/, which IS tracked.
/*.tex
/*.pdf
/*.log
# Overleaf/latexmk configuration for building the supplement against main.aux
/latexmkrc
/.latexmkrc

# LaTeX build artifacts. Thirty of these were tracked once; never again.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# LaTeX build directory for `make paper`.
/.texbuild/

# Reference PDFs kept alongside the working copy of the article; not part of
# the released artifact.
/ref/

# VS Code workspace file (local editor state)
Chiquipoli.code-workspace
