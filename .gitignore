# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local settings / agent state
.claude/

# Julia
/*.jl.cov
/*.jl.*.cov
/*.jl.mem

# Lean / Lake build artifacts and the vendored Mathlib checkout (~7 GB).
# `lean/lake-manifest.json` pins the exact Mathlib revision, so the build is
# reproducible without committing any of this.
lean/.lake/
lean/lakefile.olean

# The article is not public. Its working copies live in paper/ (main.tex,
# supplement.tex, their PDFs, the Overleaf latexmkrc, the build directory, and
# the frozen previous version under paper/archive/), and none of it is part of
# the released artifact. The whole directory is ignored.
/paper/
# The article used to live at the repository root. Kept so that a stray copy
# there is still never committed. Anchored with a leading slash on purpose: a
# bare `*.tex` would also swallow results/tables/, which IS tracked.
/*.tex
/*.pdf
/*.log
/latexmkrc
/.latexmkrc

# LaTeX build artifacts. Thirty of these were tracked once; never again.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# LaTeX build directory for `make paper` (now paper/.texbuild/, covered above).
/.texbuild/

# Reference PDFs kept alongside the working copy of the article; not part of
# the released artifact.
/ref/

# VS Code workspace file (local editor state)
Chiquipoli.code-workspace
